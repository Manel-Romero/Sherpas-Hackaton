# Sherpas Wealth Hackathon Credentials
# https://mcp-hackathon.sherpaswealth.com/personal-token

# Proxy de IAs
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com/v1
TEAM_KEY=your-team-key-here

# Servidor MCP de casos
MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp
MCP_TOKEN=your-mcp-token-here

# Modelos
FAST_MODEL=gemini-3.5-flash-lite
REASONING_MODEL=gpt-5-mini
CHAT_MODEL=gpt-5-mini

# Servidor
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# --- Voz (ElevenLabs a través del mismo proxy; usa TEAM_KEY) ---
# Presupuesto compartido: ~1,40 $ por equipo. eleven-flash-v2.5 = 0,04 $ / 1.000 caracteres.
TTS_MODEL=eleven-flash-v2.5
TTS_VOICE=alloy
STT_MODEL=scribe-v2
# VOICE_ENABLED=0   # descomenta para apagar los botones de voz
